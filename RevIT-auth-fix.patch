-.auth-link { justify-self: center; color: var(--green); font-size: 10px; font-weight: 700; }.auth-button-link { display: block; text-align: center; text-decoration: none; }
+.auth-shell { position: relative; isolation: isolate; min-height: 100svh; display: grid; place-items: center; overflow: hidden; padding: clamp(18px, 4vw, 52px); background: var(--canvas); }
+.auth-shell::before { content: ""; position: absolute; z-index: -1; width: min(720px, 65vw); height: min(720px, 65vw); top: -42%; right: -12%; border-radius: 50%; background: color-mix(in srgb, var(--green) 12%, transparent); filter: blur(12px); }
+.auth-layout { width: min(1040px, 100%); min-height: min(760px, calc(100svh - 48px)); display: grid; grid-template-columns: minmax(320px, .82fr) minmax(410px, 1fr); overflow: hidden; border: 1px solid var(--line); border-radius: 24px; background: var(--paper); box-shadow: 0 28px 90px rgba(5, 27, 22, .14); }
+.auth-intro { display: flex; flex-direction: column; justify-content: space-between; gap: 40px; padding: clamp(32px, 5vw, 58px); background: linear-gradient(150deg, #0a1a17 0%, #0d2b24 58%, #175d4e 130%); color: #f4fbf8; }
+.auth-logo { display: inline-flex; align-items: center; gap: 11px; align-self: flex-start; color: inherit; font-size: 18px; letter-spacing: -.035em; text-decoration: none; }.auth-logo .brand-mark { background: rgba(170, 241, 220, .14); color: #aef2dc; box-shadow: inset 0 0 0 1px rgba(174, 242, 220, .18); }
+.auth-intro h2 { max-width: 390px; margin: 0; font-size: clamp(34px, 4.4vw, 54px); font-weight: 760; line-height: 1.02; letter-spacing: -.055em; }.auth-intro > div > p:last-child { max-width: 420px; margin: 20px 0 0; color: #abc1bb; font-size: 13px; line-height: 1.75; }.auth-intro .eyebrow { color: #7bd9bf; }
+.auth-benefits { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }.auth-benefits li { display: flex; align-items: center; gap: 12px; padding: 13px 0; border-top: 1px solid rgba(210, 245, 235, .13); color: #d9e7e3; font-size: 11px; font-weight: 600; }.auth-benefits li span { color: #70cdb4; font-size: 9px; font-weight: 800; letter-spacing: .08em; }
+.auth-card { min-width: 0; width: 100%; align-self: center; display: grid; gap: 18px; padding: clamp(32px, 5vw, 58px); background: var(--paper); }
+.auth-heading { display: grid; gap: 10px; }.auth-heading .eyebrow { margin-bottom: 0; }.auth-card h1 { font-size: clamp(32px, 4vw, 44px); }.auth-heading > p:last-child, .security-copy { max-width: 440px; margin: 0; color: var(--muted); font-size: 12px; line-height: 1.65; }
+.auth-fields { display: grid; gap: 14px; }.auth-field { display: grid; gap: 7px; color: var(--muted); font-size: 10px; font-weight: 750; text-transform: uppercase; letter-spacing: .07em; }.auth-field input, .profile-name-field select, .profile-name-field textarea { width: 100%; min-height: 46px; border: 1px solid var(--line); border-radius: 10px; padding: 11px 13px; background: var(--input); color: var(--ink); font-size: 12px; font-weight: 500; text-transform: none; letter-spacing: 0; box-shadow: 0 1px 0 rgba(0, 0, 0, .02); }.auth-field input::placeholder { color: color-mix(in srgb, var(--muted) 65%, transparent); }.auth-field input:disabled { opacity: .72; background: var(--surface-soft); }.auth-field small { color: var(--muted); font-size: 8px; font-weight: 500; letter-spacing: 0; text-transform: none; }
+.auth-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; padding: 4px; border: 1px solid var(--line); border-radius: 11px; background: var(--surface-soft); }.auth-tabs button { border: 0; border-radius: 8px; padding: 10px; background: transparent; color: var(--muted); font-size: 11px; font-weight: 720; }.auth-tabs button.active { background: var(--paper); color: var(--green-dark); box-shadow: 0 3px 10px rgba(0, 0, 0, .07); }
+.check-label { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 10px; }.check-label input { width: 14px; height: 14px; accent-color: var(--green); }
+.form-status { margin: 0 !important; padding: 10px 12px; border: 1px solid color-mix(in srgb, var(--danger) 28%, var(--line)); border-radius: 9px; background: var(--danger-soft); color: var(--danger) !important; font-size: 10px !important; line-height: 1.55; }.form-status.success { border-color: color-mix(in srgb, var(--green) 28%, var(--line)); background: var(--green-soft); color: var(--green-dark) !important; }.form-status.info { border-color: var(--line); background: var(--surface-soft); color: var(--muted) !important; }
+.otp-panel { display: grid; gap: 14px; padding: 15px; border: 1px solid color-mix(in srgb, var(--green) 28%, var(--line)); border-radius: 12px; background: var(--surface-tint); }.otp-panel.verified { background: var(--green-soft); }.otp-panel-heading { min-width: 0; display: flex; align-items: center; gap: 10px; }.otp-panel-heading > div { min-width: 0; }.otp-panel-heading strong, .otp-panel-heading small { display: block; }.otp-panel-heading strong { font-size: 11px; }.otp-panel-heading small { overflow: hidden; margin-top: 3px; color: var(--muted); font-size: 9px; text-overflow: ellipsis; white-space: nowrap; }.otp-icon { flex: 0 0 auto; display: grid; place-items: center; width: 31px; height: 31px; border-radius: 9px; background: var(--green-soft); color: var(--green-dark); font-size: 13px; font-weight: 800; }.otp-field input { text-align: center; font-size: 18px; font-weight: 750; letter-spacing: .32em; }.otp-actions { display: flex; align-items: center; justify-content: space-between; gap: 10px; }.otp-actions .text-button { padding-block: 2px; font-size: 9px; }
+.registration-actions { display: grid; gap: 9px; }.auth-card .wide { margin-top: 0; }.auth-submit { min-height: 45px; }.create-account-help { color: var(--muted); font-size: 8px; text-align: center; }.auth-link { justify-self: center; color: var(--green); font-size: 10px; font-weight: 700; }.auth-button-link { display: block; text-align: center; text-decoration: none; }
+@media (max-width: 860px) {
+  .auth-shell { place-items: start center; overflow: visible; }.auth-layout { min-height: 0; grid-template-columns: 1fr; }.auth-intro { min-height: 340px; padding: 34px; }.auth-intro h2 { max-width: 560px; }.auth-intro > div > p:last-child { max-width: 580px; }.auth-benefits { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }.auth-benefits li { align-items: flex-start; }.auth-card { min-height: 0; padding: 38px 34px; }
+}
+@media (max-width: 520px) {
+  .auth-shell { display: block; padding: 0; }.auth-layout { min-height: 100svh; border: 0; border-radius: 0; }.auth-intro { min-height: 250px; gap: 28px; padding: 26px 22px; }.auth-intro h2 { font-size: 34px; }.auth-intro > div > p:last-child { margin-top: 14px; font-size: 11px; }.auth-benefits { display: none; }.auth-card { gap: 16px; padding: 30px 20px 38px; }.auth-card h1 { font-size: 32px; }.otp-actions { align-items: flex-start; flex-direction: column; }
+}
 .onboarding-backdrop { position: fixed; z-index: 80; inset: 0; overflow-y: auto; display: grid; place-items: center; padding: 20px; background: rgba(5,18,15,.76); backdrop-filter: blur(8px); }.onboarding-card { width: min(560px, 100%); padding: clamp(24px, 5vw, 42px); border: 1px solid var(--line); border-radius: 22px; background: var(--paper); box-shadow: 0 30px 100px rgba(0,0,0,.3); }.onboarding-card h1 { font-size: clamp(31px, 6vw, 46px); }.onboarding-card > div > p:last-child { color: var(--muted); line-height: 1.65; }.onboarding-card form { display: grid; gap: 16px; }
 .account-modal { width: min(620px, 100%); max-height: min(860px, calc(100vh - 40px)); overflow-y: auto; }.account-modal .auth-tabs { margin: 18px 0; }.security-stack { display: grid; gap: 25px; }.security-stack > form, .mfa-section { display: grid; gap: 12px; padding-bottom: 22px; border-bottom: 1px solid var(--line); }.mfa-qr { width: 180px; height: 180px; border: 10px solid #fff; border-radius: 10px; }.mfa-secret { margin: 0; color: var(--muted); font-size: 9px; overflow-wrap: anywhere; }
 
