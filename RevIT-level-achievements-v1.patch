+.profile-card { margin-top: 18px; overflow: hidden; border: 1px solid #29443e; border-radius: 13px; background: var(--sidebar-surface); }
+.profile-card .profile { width: 100%; margin: 0; padding: 11px 12px 9px; }
+.profile-level { width: 100%; display: grid; gap: 7px; border: 0; border-top: 1px solid #29443e; padding: 9px 12px 11px; background: transparent; color: #fff; text-align: left; }
+.profile-level:hover { background: var(--sidebar-active); }.profile-level > span { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }.profile-level b { color: #9fd9c8; font-size: 9px; text-transform: uppercase; letter-spacing: .07em; }.profile-level strong { overflow: hidden; font-size: 9px; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
