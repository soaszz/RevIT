# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/
/next-env.d.ts
*.tsbuildinfo

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
.npmrc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files may contain credentials. Keep only the credential-free template.
.env*
!.env.example

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# local comparison/workspace copies
/RevIT*-working/

# local provider experiment (not used by RevIT)
/chatbot/
changelog-private.md
supabase/.temp/
/scratch/
/.scratch/

# Commercial reviewer inputs: local/private deployment pack, never public Git.
/.private-reviewers/
/app/content/bocContent.json
/app/content/elsevierContent.json
/app/content/bocSourceManifest.json
/app/content/elsevierSourceManifest.json
/docs/reviewer-compatibility/boc-presentation-source-fixture.json
/public/reviewer-assets/boc-7e/
/public/reviewer-assets/elsevier-1e/
